{
    "name": "song-engine",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "pnpm lint && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "pnpm typecheck && pnpm lint:biome",
        "lint:biome": "biome check src/",
        "audit:biome": "biome lint --rule=correctness/noUnusedVariables --rule=correctness/noUnusedImports src/"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.4",
        "@tailwindcss/vite": "^4.2.1",
        "@types/seedrandom": "^3.0.8",
        "@vitejs/plugin-basic-ssl": "^2.1.4",
        "prettier": "^3.8.1",
        "tailwindcss": "^4.2.1",
        "ts-morph": "^27.0.2",
        "typescript": "^5.9.3",
        "vite": "^7.3.1"
    },
    "dependencies": {
        "neverthrow": "^8.2.0",
        "remeda": "^2.33.6",
        "seedrandom": "^3.0.5",
        "tonal": "^6.4.3",
        "tone": "^15.1.22"
    }
}
